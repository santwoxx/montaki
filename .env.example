# Copie este arquivo para ".env" e preencha com os valores da sua própria
# implantação. Nenhum destes valores deve ser um segredo real neste arquivo
# de exemplo — o ".env" de verdade nunca deve ser commitado (já está no
# .gitignore).

# --- Firebase (banco de dados e login) ----------------------------------
# Credencial da conta de serviço, usada pelo servidor para ler e gravar no
# Firestore. No console do Firebase: Configurações do projeto → Contas de
# serviço → "Gerar nova chave privada". Isso baixa um arquivo .json.
#
# Forma mais simples: cole o conteúdo inteiro do .json (numa linha só) aqui.
# É um SEGREDO de verdade — quem tem essa chave tem acesso total ao banco.
FIREBASE_SERVICE_ACCOUNT=""

# Alternativa aos três campos separados, se preferir (use uma forma OU a
# outra). As quebras de linha da chave privada podem vir como "\n".
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# E-mails autorizados a entrar como administrador pelo Google, separados por
# vírgula. Os e-mails padrão definidos no código são "pedrobmcity@gmail.com,brisasofc@gmail.com".
# Deixe em branco para usar os padrões ou informe os e-mails desejados.
ADMIN_EMAILS="pedrobmcity@gmail.com,brisasofc@gmail.com"

# Configuração pública do app web (a mesma do console do Firebase). Não são
# segredos — só são necessárias se você trocar o projeto do Firebase; sem
# elas o sistema usa os valores padrão de lib/firebase/cliente.ts.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- Sessão de login ------------------------------------------------------
# Qualquer string longa e aleatória — usada para assinar o cookie de sessão.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET="troque-isso-por-uma-chave-aleatoria-longa"

# --- Upload de arquivos (Vercel Blob) -----------------------------------
# Criada automaticamente ao conectar um Vercel Blob Store ao projeto na
# Vercel. Necessária para fotos de comprovante, manuais e ocorrências.
BLOB_READ_WRITE_TOKEN=""

# --- Migração do banco antigo (opcional, uma vez só) --------------------
# Só para quem já tinha o sistema rodando no Postgres e vai copiar os dados
# para o Firestore com `npm run migrar:postgres`. Depois da migração, estas
# variáveis podem ser removidas.
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# --- Integração com sistema externo (opcional) --------------------------
# Só é necessária se você quiser receber pedidos de outro sistema seu (ex:
# um app de pedidos/entregas) via API em vez de importar notas manualmente.
# Sem essas variáveis, essa integração fica desativada e o resto do sistema
# funciona normalmente.
#
# Chave que o sistema externo deve enviar no header "x-integracao-key" ao
# chamar POST /api/notas-pendentes:
EXTERNAL_INTEGRATION_API_KEY=""
# Origem (domínio) autorizada a chamar essa API pelo navegador, para CORS:
EXTERNAL_INTEGRATION_ORIGIN=""
# URL que este sistema chama para avisar o sistema externo quando uma
# montagem vinda de lá é concluída e confirmada por um admin:
EXTERNAL_INTEGRATION_WEBHOOK_URL=""
# Chave enviada nessa chamada de volta (header "x-montaki-key"):
EXTERNAL_INTEGRATION_WEBHOOK_KEY=""
